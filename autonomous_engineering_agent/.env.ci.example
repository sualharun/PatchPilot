GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=ci-webhook-secret
PATCHPILOT_DOMAIN=patchpilot-ci.example.invalid
ACME_EMAIL=ci@example.invalid
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:////tmp/patchpilot-ci.sqlite3
AGENT_LOGS_DIR=/tmp/patchpilot-ci-logs
ARTIFACT_STORAGE_DIR=/tmp/patchpilot-ci-artifacts
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=ci
DASHBOARD_PASSWORD=ci-password-change-me
DASHBOARD_SESSION_SECRET=ci-session-secret-change-me
DASHBOARD_SECURE_COOKIES=false
DASHBOARD_DEMO_DATA_ENABLED=true
GITHUB_OAUTH_CLIENT_ID=ci-client-id
GITHUB_OAUTH_CLIENT_SECRET=ci-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8080/auth/github/callback
GITHUB_OAUTH_MOCK_ENABLED=true
GITHUB_APP_INSTALL_URL=https://github.com/apps/patchpilot-ci/installations/new
GITHUB_APP_ID=1
GITHUB_APP_INSTALLATION_ID=1
GITHUB_APP_PRIVATE_KEY_PATH=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PR_ANALYSIS_TOPIC=pr-analysis-jobs
KAFKA_CONSUMER_GROUP=patchpilot-pr-workers
PR_ANALYSIS_STATUS_CONTEXT=patchpilot/pr-analysis
PATCHPILOT_PRODUCTION=false

[Unit]
Description=PatchPilot Postgres backup restore verification
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Adjust to wherever the repo is actually cloned on this host.
WorkingDirectory=/opt/patchpilot/app
ExecStart=/opt/patchpilot/app/scripts/verify-postgres-backup.sh
Environment=BACKUP_DIR=/opt/patchpilot/backups
# Non-zero exit here means the most recent backup could NOT be restored -- treat as an incident.
# Failures are visible via: systemctl status patchpilot-backup-verify.service / journalctl -u patchpilot-backup-verify.service
